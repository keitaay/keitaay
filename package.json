{
  "name": "keita",
  "version": "1.0.0",
  "description": "Static personal website for Keita Yokoyama, generated using 11ty",
  "main": "index.js",
  "scripts": {
    "test": "node scripts/check-content.mjs",
    "test:a11y": "npm run build && start-server-and-test \"http-server _public -p 8081 -s\" http://127.0.0.1:8081 pa11y-ci",
    "build": "eleventy && node scripts/minify-assets.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keitaay/keitaay.git"
  },
  "author": "Keita A. Yokoyama",
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-img": "^7.0.0",
    "clean-css": "^5.3.3",
    "eleventy-plugin-gen-favicons": "^1.1.3",
    "sharp": "^0.35.3",
    "terser": "^5.50.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "gray-matter": "^4.0.3",
    "http-server": "^14.1.1",
    "pa11y-ci": "^4.1.1",
    "start-server-and-test": "^3.0.12"
  },
  "overrides": {
    "eleventy-plugin-gen-favicons": {
      "sharp": "^0.35.3"
    },
    "puppeteer": "^25.7.0"
  }
}
